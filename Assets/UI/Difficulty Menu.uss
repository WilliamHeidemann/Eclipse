:root {
}

.difficulty-button {
    margin-top: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    width: 37%;
    height: 7%;
    font-size: 43px;
    -unity-font-definition: url("project://database/Assets/Font/opticenturyschoolbookbold.otf?fileID=12800000&guid=fcc67d2f5a2ac3b4aa8027e1fdb59932&type=3#opticenturyschoolbookbold");
    -unity-font-style: italic;
    background-color: rgba(255, 255, 255, 0.247);
    color: rgb(255, 255, 255);
}

.difficulty-container {
    justify-content: center;
    align-items: center;
}

.back-button {
    flex-grow: 0.1;
    background-image: url("project://database/Assets/Sprites/Eclipse%20Card%20Game/Menu%20Elements/Asset%2018@4x.png?fileID=2800000&guid=b8c74ede5e309c242aa56cb6e93986b0&type=3#Asset 18@4x");
    -unity-background-scale-mode: scale-to-fit;
    align-self: flex-start;
    min-width: 6%;
    min-height: 1%;
    background-color: rgba(188, 188, 188, 0);
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
}

.difficulty-menu {
    flex-grow: 1;
    margin-top: 121px;
    margin-right: 121px;
    margin-bottom: 121px;
    margin-left: 121px;
}
