:root {
}

.difficulty-button {
    margin-top: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    width: 77%;
    height: 7%;
    font-size: 43px;
    -unity-font-definition: url("project://database/Assets/Font/opticenturyschoolbookbold.otf?fileID=12800000&guid=fcc67d2f5a2ac3b4aa8027e1fdb59932&type=3#opticenturyschoolbookbold");
    -unity-font-style: italic;
    background-color: rgba(255, 255, 255, 0.247);
    color: rgb(255, 255, 255);
}

.difficulty-container {
    justify-content: center;
    align-items: center;
}

.difficulty-menu {
    flex-grow: 1;
    margin-top: 121px;
    margin-right: 121px;
    margin-bottom: 121px;
    margin-left: 121px;
}
