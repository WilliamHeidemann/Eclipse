:root {
}

.sub-menu {
    flex-grow: 1;
    margin-top: 124px;
    margin-right: 124px;
    margin-bottom: 124px;
    margin-left: 124px;
}

.friend-request-input {
    -unity-font-definition: url("project://database/Assets/Font/opticenturyschoolbookbold.otf?fileID=12800000&guid=fcc67d2f5a2ac3b4aa8027e1fdb59932&type=3#opticenturyschoolbookbold");
    -unity-text-align: middle-left;
    flex-grow: 1;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    height: 48px;
}

.friend-request-input > .unity-base-field__input {
    background-color: rgba(188, 188, 188, 0.5);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
}

.friend-request-input .unity-base-text-field__input--placeholder {
    color: rgba(0, 0, 0, 0.42);
    -unity-font-style: italic;
    font-size: 19px;
    padding-left: 21px;
}

.request-section {
    flex-grow: 0;
}
