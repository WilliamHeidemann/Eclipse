:root {
}

.sub-menu {
    flex-grow: 1;
    margin-top: 30px;
    margin-right: 30px;
    margin-bottom: 30px;
    margin-left: 30px;
}

.back-button {
    flex-grow: 0.1;
    background-image: url("project://database/Assets/Sprites/Eclipse%20Card%20Game/Menu%20Elements/Asset%2018@4x.png?fileID=2800000&guid=b8c74ede5e309c242aa56cb6e93986b0&type=3#Asset 18@4x");
    -unity-background-scale-mode: scale-to-fit;
    align-self: flex-start;
    min-width: 6%;
    min-height: 1%;
    background-color: rgba(188, 188, 188, 0);
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
}

.section-heading {
    -unity-font-style: italic;
    color: rgb(195, 195, 195);
    -unity-font-definition: url("project://database/Assets/Font/opticenturyschoolbookbold.otf?fileID=12800000&guid=fcc67d2f5a2ac3b4aa8027e1fdb59932&type=3#opticenturyschoolbookbold");
    margin-top: 46px;
}

.friend-request-input {
    -unity-font-definition: url("project://database/Assets/Font/opticenturyschoolbookbold.otf?fileID=12800000&guid=fcc67d2f5a2ac3b4aa8027e1fdb59932&type=3#opticenturyschoolbookbold");
    -unity-text-align: middle-left;
    flex-grow: 1;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.friend-request-input > .unity-base-field__input {
    background-color: rgba(188, 188, 188, 0.5);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
}

.friend-request-input .unity-base-text-field__input--placeholder {
    color: rgba(0, 0, 0, 0.42);
    -unity-font-style: italic;
    font-size: 10px;
}
