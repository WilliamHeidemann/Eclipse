<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Friend" src="project://database/Assets/UI/Friend.uxml?fileID=9197481963319205126&amp;guid=1a35536f453f45747a65de9c1db2e6b5&amp;type=3#Friend"/>
    <ui:Template name="FriendRequest" src="project://database/Assets/UI/FriendRequest.uxml?fileID=9197481963319205126&amp;guid=876119e7e71c9b24eb579bc764e0604b&amp;type=3#FriendRequest"/>
    <ui:Template name="GameRequest" src="project://database/Assets/UI/GameRequest.uxml?fileID=9197481963319205126&amp;guid=81306f91731dcc441ae6fb1a86b5bc77&amp;type=3#GameRequest"/>
    <Style src="project://database/Assets/UI/styles.uss?fileID=7433441132597879392&amp;guid=cb1d2706049614e018463c0d001025a6&amp;type=3#styles"/>
    <Style src="project://database/Assets/UI/MenuStyles.uss?fileID=7433441132597879392&amp;guid=34018f246eda05847ac2c1594faa96b4&amp;type=3#MenuStyles"/>
    <Style src="project://database/Assets/UI/Friends%20Menu.uss?fileID=7433441132597879392&amp;guid=45225a7f09b64ef48a623f1dbbf3d3dd&amp;type=3#Friends Menu"/>
    <ui:VisualElement name="FriendsMenu" class="sub-menu" style="-unity-font-definition: url(&quot;project://database/Assets/Font/opticenturyschoolbookbold.otf?fileID=12800000&amp;guid=fcc67d2f5a2ac3b4aa8027e1fdb59932&amp;type=3#opticenturyschoolbookbold&quot;);">
        <ui:Button name="Back" class="menu-back-button"/>
        <ui:Label text="Welcome" name="Welcome" class="menu-name-label" style="font-size: 22px; color: rgb(214, 214, 214); -unity-font-style: italic;"/>
        <ui:Label text="&#10;" name="PlayerName" style="font-size: 60px; -unity-text-align: upper-center; -unity-font-style: italic; color: rgb(255, 255, 255); margin-bottom: 135px;"/>
        <ui:ScrollView name="FriendsContentScrollView" horizontal-scroller-visibility="Hidden" style="flex-grow: 1;">
            <ui:VisualElement name="SendRequest" class="request-section" style="flex-grow: 0;">
                <ui:Label text="Send Friend Request" name="SendRequestLabel" class="menu-section-heading"/>
                <ui:VisualElement style="flex-direction: row;">
                    <ui:TextField name="FriendRequestInput" label="" placeholder-text="Friend#1234..." class="friend-request-input"/>
                    <ui:Button name="SendFriendRequestButton" text="Send" class="menu-primary-button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 10px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-grow: 0.2; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(188, 188, 188, 0.498); font-size: 27px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="FriendsList" class="request-section" style="flex-grow: 0;">
                <ui:Label text="Friends" name="FriendsLabel" class="menu-section-heading"/>
                <ui:ScrollView name="FriendsScrollView" horizontal-scroller-visibility="AlwaysVisible">
                    <ui:Instance template="Friend"/>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="FriendRequests" class="request-section">
                <ui:Label text="Friend Requests" name="FriendRequestsLabel" class="menu-section-heading"/>
                <ui:ScrollView name="FriendRequestsScrollView" horizontal-scroller-visibility="AlwaysVisible">
                    <ui:Instance template="FriendRequest"/>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="GameRequests" class="request-section">
                <ui:Label text="Game Requests" name="GameRequestsLabel" class="menu-section-heading"/>
                <ui:ScrollView name="GameRequestsScrollView" horizontal-scroller-visibility="Hidden">
                    <ui:Instance template="GameRequest"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
