.game-request {
    flex-grow: 1;
    flex-direction: row;
    -unity-font-definition: url("project://database/Assets/Font/opticenturyschoolbookbold.otf?fileID=12800000&guid=fcc67d2f5a2ac3b4aa8027e1fdb59932&type=3#opticenturyschoolbookbold");
    margin-top: 15px;
    margin-bottom: 15px;
}

.invitation {
    flex-grow: 1;
    background-color: rgba(168, 168, 168, 0.176);
    max-width: 66%;
    min-width: 66%;
    justify-content: center;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-right: 4%;
}

.request-buttons {
    flex-grow: 1;
}

.accept-button {
    background-color: rgb(0, 10, 53);
    color: rgb(255, 255, 255);
    flex-grow: 1;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 5px;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.decline-button {
    color: rgb(255, 255, 255);
    background-color: rgb(202, 76, 68);
    flex-grow: 1;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-top: 5%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-right: 0%;
    margin-bottom: 0%;
    margin-left: 0%;
}

.name {
    font-size: 16px;
    padding-top: 5%;
    padding-right: 5%;
    padding-bottom: 0%;
    padding-left: 5%;
    color: rgb(255, 255, 255);
}

.description {
    padding-top: 0%;
    padding-right: 5%;
    padding-bottom: 5%;
    padding-left: 5%;
    color: rgb(255, 255, 255);
}
