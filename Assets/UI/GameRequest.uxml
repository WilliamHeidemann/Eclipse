<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GameRequest.uss?fileID=7433441132597879392&amp;guid=4ccf3e12f9844ed4b3fd5a950a497c18&amp;type=3#GameRequest"/>
    <ui:VisualElement name="GameRequest" class="game-request">
        <ui:VisualElement name="Invitation" class="invitation" style="min-width: 66%;">
            <ui:Label text="Selma#1234" name="Name" class="name"/>
            <ui:Label text="wants to play with you!" name="Description" class="description" style="font-size: 24px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Buttons" class="request-buttons">
            <ui:Button text="Accept" name="Accept" class="accept-button"/>
            <ui:Button text="Decline" name="Decline" class="decline-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
