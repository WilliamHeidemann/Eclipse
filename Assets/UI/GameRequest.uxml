<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/styles.uss?fileID=7433441132597879392&amp;guid=cb1d2706049614e018463c0d001025a6&amp;type=3#styles"/>
    <Style src="project://database/Assets/UI/MenuStyles.uss?fileID=7433441132597879392&amp;guid=34018f246eda05847ac2c1594faa96b4&amp;type=3#MenuStyles"/>
    <Style src="project://database/Assets/UI/GameRequest.uss?fileID=7433441132597879392&amp;guid=4ccf3e12f9844ed4b3fd5a950a497c18&amp;type=3#GameRequest"/>
    <ui:VisualElement name="GameRequest" class="menu-font game-request">
        <ui:VisualElement name="Invitation" class="invitation menu-request-panel" style="min-width: 66%;">
            <ui:Label text="Selma#1234" name="Name" class="name menu-name-label"/>
            <ui:Label text="wants to play with you!" name="Description" class="description" style="font-size: 24px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Buttons" class="request-buttons">
            <ui:Button text="Accept" name="Accept" class="accept-button menu-primary-button"/>
            <ui:Button text="Decline" name="Decline" class="decline-button menu-primary-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
