.menu-font {
    -unity-font-definition: url("project://database/Assets/Font/opticenturyschoolbookbold.otf?fileID=12800000&guid=fcc67d2f5a2ac3b4aa8027e1fdb59932&type=3#opticenturyschoolbookbold");
}

.menu-back-button {
    flex-grow: 0.1;
    background-image: url("project://database/Assets/Sprites/Eclipse%20Card%20Game/Menu%20Elements/Asset%2018@4x.png?fileID=2800000&guid=b8c74ede5e309c242aa56cb6e93986b0&type=3#Asset 18@4x");
    -unity-background-scale-mode: scale-to-fit;
    align-self: flex-start;
    min-width: 6%;
    min-height: 1%;
    background-color: rgba(188, 188, 188, 0);
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.menu-section-heading {
    -unity-font-style: italic;
    color: rgb(195, 195, 195);
    -unity-font-definition: url("project://database/Assets/Font/opticenturyschoolbookbold.otf?fileID=12800000&guid=fcc67d2f5a2ac3b4aa8027e1fdb59932&type=3#opticenturyschoolbookbold");
    margin-top: 46px;
    font-size: 36px;
}

.menu-request-panel {
    justify-content: center;
    flex-grow: 1;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    background-color: rgba(207, 207, 207, 0.176);
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.menu-name-label {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: upper-center;
    color: rgb(255, 255, 255);
}

.menu-primary-button {
    border-top-left-radius: 25px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgb(0, 10, 53);
    color: rgb(255, 255, 255);
}

.menu-secondary-button {
    border-top-left-radius: 40px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 40px;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgba(188, 188, 188, 0.49);
    color: rgb(255, 255, 255);
}
