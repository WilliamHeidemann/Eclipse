<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Style%20Sheets/styles.uss?fileID=7433441132597879392&amp;guid=cb1d2706049614e018463c0d001025a6&amp;type=3#styles"/>
    <Style src="project://database/Assets/UI/Style%20Sheets/MenuStyles.uss?fileID=7433441132597879392&amp;guid=34018f246eda05847ac2c1594faa96b4&amp;type=3#MenuStyles"/>
    <Style src="project://database/Assets/UI/Style%20Sheets/GameUI.uss?fileID=7433441132597879392&amp;guid=3154dc20cc3434f4cab619b03a1c27e6&amp;type=3#GameUI"/>
    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; margin-top: 64px; margin-right: 64px; margin-bottom: 64px; margin-left: 64px;">
        <ui:VisualElement name="TopBar" picking-mode="Ignore" class="game-top-bar">
            <ui:Button text="" name="Back" class="menu-back-button game-back-button"/>
            <ui:VisualElement name="PlayerPanel" picking-mode="Ignore" class="game-player-panel">
                <ui:VisualElement name="PlayerOneRow" picking-mode="Ignore" class="game-player-row">
                    <ui:Label text="Player 1" name="PlayerOneLabel" class="game-player-label"/>
                    <ui:VisualElement name="PlayerOneIcon" picking-mode="Ignore" class="game-player-icon" style="background-image: url(&quot;project://database/Assets/Sprites/UI%20Assets/Player%20Tokens/Player%20Token%20V1.png?fileID=2800000&amp;guid=e2168c75841c57041b6df16da3d0b289&amp;type=3#Player Token V1&quot;); background-color: rgba(255, 95, 95, 0);"/>
                </ui:VisualElement>
                <ui:VisualElement name="PlayerTwoRow" picking-mode="Ignore" class="game-player-row">
                    <ui:Label text="Player 2" name="PlayerTwoLabel" class="game-player-label"/>
                    <ui:VisualElement name="PlayerTwoIcon" picking-mode="Ignore" class="game-player-icon game-player-icon--second" style="background-image: url(&quot;project://database/Assets/Sprites/UI%20Assets/Player%20Tokens/Player%20Token%20V2.png?fileID=2800000&amp;guid=a45770585660120478fcbbf05b02c9a3&amp;type=3#Player Token V2&quot;); background-color: rgba(255, 252, 95, 0);"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1;"/>
    </ui:VisualElement>
</ui:UXML>
