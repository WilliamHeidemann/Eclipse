:root {
}

.main-menu-root {
    flex-grow: 1;
    min-height: 0;
    padding-top: 24px;
    padding-right: 32px;
    padding-bottom: 24px;
    padding-left: 32px;
    background-color: rgb(10, 14, 24);
    color: rgb(237, 242, 247);
    -unity-font-definition: url("project://database/Assets/Font/HelveticaNeue-main/HelveticaNeue-CondensedBlack.ttf?fileID=12800000&guid=e62e3fe37f8654dfda7536581863965d&type=3#HelveticaNeue-CondensedBlack");
}

.header {
    align-items: center;
    margin-bottom: 20px;
    margin-top: 54px;
}

.logo-text {
    font-size: 84px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.subtitle-text {
    font-size: 26px;
    color: rgb(160, 174, 192);
    -unity-text-align: middle-center;
}

.panel {
    background-color: rgb(21, 28, 44);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(49, 60, 87);
    border-right-color: rgb(49, 60, 87);
    border-top-color: rgb(49, 60, 87);
    border-bottom-color: rgb(49, 60, 87);
    padding-top: 14px;
    padding-right: 14px;
    padding-bottom: 14px;
    padding-left: 14px;
}

.player-panel {
    margin-bottom: 16px;
    flex-shrink: 0;
}

.panel-title {
    font-size: 30px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.name-row {
    flex-direction: row;
    align-items: center;
}

.player-name-label {
    min-width: 120px;
    font-size: 26px;
}

.text-input {
    flex-grow: 1;
    margin-right: 8px;
}

.text-input > .unity-base-field__label {
    display: none;
}

.text-input > .unity-base-field__input {
    min-height: 34px;
    font-size: 26px;
    background-color: rgb(13, 18, 30);
    color: rgb(237, 242, 247);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(56, 73, 110);
    border-right-color: rgb(56, 73, 110);
    border-top-color: rgb(56, 73, 110);
    border-bottom-color: rgb(56, 73, 110);
    padding-left: 10px;
    -unity-font-definition: url("project://database/Assets/Font/HelveticaNeue-main/HelveticaNeue-CondensedBlack.ttf?fileID=12800000&guid=e62e3fe37f8654dfda7536581863965d&type=3#HelveticaNeue-CondensedBlack");
}

.body {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

.friends-panel {
    flex-grow: 1;
    min-height: 0;
    flex-basis: 0;
    margin-bottom: 16px;
}

.requests-panel {
    flex-grow: 1;
    min-height: 0;
    flex-basis: 0;
}

.friends-list,
.request-list {
    flex-grow: 1;
    min-height: 0;
    flex-shrink: 1;
    margin-bottom: 10px;
}

.friends-list > .unity-scroll-view__vertical-scroller,
.friends-list > .unity-scroll-view__horizontal-scroller,
.request-list > .unity-scroll-view__vertical-scroller,
.request-list > .unity-scroll-view__horizontal-scroller {
    display: none;
}

.friend-row,
.request-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    background-color: rgb(31, 40, 62);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.row-name {
    font-size: 24px;
    margin-right: 8px;
}

.row-actions {
    flex-direction: row;
    align-items: center;
}

.section-label {
    font-size: 24px;
    color: rgb(173, 189, 211);
    margin-bottom: 8px;
}

.send-request-row {
    flex-direction: row;
    align-items: center;
}

.primary-button,
.secondary-button,
.accept-button,
.danger-button {
    min-width: 88px;
    min-height: 34px;
    font-size: 24px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    color: rgb(245, 248, 255);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Font/HelveticaNeue-main/HelveticaNeue-CondensedBlack.ttf?fileID=12800000&guid=e62e3fe37f8654dfda7536581863965d&type=3#HelveticaNeue-CondensedBlack");
}

.primary-button {
    background-color: rgb(61, 107, 255);
}

.secondary-button {
    background-color: rgb(83, 118, 183);
}

.accept-button {
    background-color: rgb(41, 155, 92);
    margin-right: 6px;
}

.danger-button {
    background-color: rgb(186, 64, 64);
}

.challenge-modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.65);
}

.challenge-modal {
    min-width: 460px;
    max-width: 500px;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    background-color: rgb(21, 28, 44);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(49, 60, 87);
    border-right-color: rgb(49, 60, 87);
    border-top-color: rgb(49, 60, 87);
    border-bottom-color: rgb(49, 60, 87);
}

.challenge-modal-title {
    font-size: 36px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    white-space: normal;
}

.challenge-modal-message {
    font-size: 24px;
    color: rgb(210, 222, 240);
    margin-bottom: 16px;
}

.challenge-modal-actions {
    flex-direction: row;
    justify-content: space-around;
}
